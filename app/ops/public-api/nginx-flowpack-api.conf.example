# Replace every __PLACEHOLDER__ before installing this as a file included directly by Nginx's http block.
# Only the authenticated external API is exposed; the app and worker routes stay private.

limit_req_zone $binary_remote_addr zone=flowpack_external_api:10m rate=60r/m;

server {
    listen 443 ssl http2;
    server_name __PUBLIC_API_HOST__;

    ssl_certificate __TLS_CERTIFICATE_PATH__;
    ssl_certificate_key __TLS_PRIVATE_KEY_PATH__;
    client_max_body_size 21m;

    location ^~ /api/v1/ {
        limit_except GET POST PATCH { deny all; }
        limit_req zone=flowpack_external_api burst=20 nodelay;

        proxy_pass http://127.0.0.1:__FLOWPACK_NAS_HTTP_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering on;
        proxy_connect_timeout 5s;
        proxy_read_timeout 310s;

        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    location / {
        return 404;
    }
}
