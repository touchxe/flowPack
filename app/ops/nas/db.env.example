# Copy to the NAS release directory as .env.nas.db.local and chmod 600.
# The db service receives only this file. Use URL-safe generated passwords and
# never reuse the owner credential in the application DATABASE_URL.

POSTGRES_DB=flowpack
POSTGRES_USER=flowpack_owner
POSTGRES_PASSWORD=replace_with_generated_owner_secret
FLOWPACK_APP_RW_DB_PASSWORD=replace_with_generated_rw_secret
FLOWPACK_APP_RO_DB_PASSWORD=replace_with_generated_ro_secret
