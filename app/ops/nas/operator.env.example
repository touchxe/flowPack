# Copy to the laptop app root as .env.nas-operator.local and chmod 600.
# This file selects only the local restricted-gateway profile and its four
# installed SHA-256 pins. Host, port, approved DSM administrators-group user,
# known-host material, and the exact flowpack_gateway_ed25519 identity live in
# that mode-0700 profile; no remote root, Compose
# executable, Docker coordinate, runtime env path, URL or application secret is
# accepted by the standard operator.

NAS_GATEWAY_PROFILE_DIR=/absolute/private/path/flowpack-v2-gateway-profile
NAS_GATEWAY_ACTION_SET_SHA256=replace_with_64_lowercase_hex
NAS_GATEWAY_HELPER_SHA256=replace_with_64_lowercase_hex
NAS_GATEWAY_POLICY_SHA256=replace_with_64_lowercase_hex
# Set locally to the SHA-256 of deploy/restricted-gateway-v1.contract.json.
# Helper, policy and action-set pins still come only from the installed gateway.
NAS_GATEWAY_PROTOCOL_SHA256=replace_with_64_lowercase_hex
