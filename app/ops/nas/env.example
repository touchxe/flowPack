# Copy to the NAS release directory as .env.nas.local and chmod 600. Database
# owner/bootstrap credentials belong only in the separate .env.nas.db.local
# created from db.env.example. Never commit real values.

FLOWPACK_DATA_ROOT=/volumeX/path/flowpack
FLOWPACK_NAS_HTTP_PORT=13002
FLOWPACK_NAS_ENV_FILE=.env.nas.local
FLOWPACK_NAS_DB_ENV_FILE=.env.nas.db.local
COMPOSE_PROJECT_NAME=flowpack-nas

# Destination restore and zero-write smoke use this role. Do not switch both
# lines below until ZERO_WRITE_SMOKE_PASSED is recorded. The controlled switch
# is FLOWPACK_WRITE_MODE=read-write plus DATABASE_URL user flowpack_app_rw,
# followed by a web-only forced recreate and a write/role health verification.
FLOWPACK_WRITE_MODE=read-only
DATABASE_URL=postgresql://flowpack_app_ro:replace_with_generated_ro_secret@db:5432/flowpack

NEXTAUTH_URL=https://replace-with-private-tailscale-service
AUTH_URL=https://replace-with-private-tailscale-service
AUTH_TRUST_HOST=true
AUTH_SECRET=preserve_existing_value_during_migration
SOCIAL_TOKEN_ENCRYPTION_KEY=preserve_existing_value_during_migration

FLOWPACK_STORAGE_DRIVER=nas
FLOWPACK_PUBLIC_CALLBACKS_ENABLED=false
FLOWPACK_PUBLIC_MEDIA_ENABLED=false
FLOWPACK_SCHEDULER_ENABLED=false
FLOWPACK_EXTERNAL_API_ENABLED=false
# Set FLOWPACK_EXTERNAL_API_ENABLED=true and COMPOSE_PROFILES=external-api only
# after the public /api/v1-only gateway, API migration, a distinct
# >=32-character worker secret, and the controlled FLOWPACK_WRITE_MODE=read-write
# plus flowpack_app_rw DATABASE_URL cutover are complete. The flag never bypasses
# the read-only write gate.
COMPOSE_PROFILES=
FLOWPACK_WORKER_SECRET=
FLOWPACK_AUTH_PROVIDERS=credentials
# Temporarily set true only for the destination read-only credential rehearsal.
# Generate a distinct >=32-character value locally; never copy it into a report.
FLOWPACK_AUTH_SMOKE_ENABLED=false
FLOWPACK_AUTH_SMOKE_TOKEN=replace_with_distinct_operator_smoke_token
FLOWPACK_AUTH_SMOKE_REQUIRE_ADMIN=true
# Separately enable only for the bounded active-social-token continuity probe.
# Keep this operator token distinct from user credentials and the login probe.
FLOWPACK_SOCIAL_TOKEN_SMOKE_ENABLED=false
FLOWPACK_SOCIAL_TOKEN_SMOKE_TOKEN=replace_with_distinct_social_token_smoke_token

# Optional browser-reviewed OAuth providers. Keep these empty and keep
# FLOWPACK_AUTH_PROVIDERS=credentials unless the exact private HTTPS callback
# has passed a real provider login rehearsal. Enable only by appending the
# reviewed provider IDs after credentials (for example credentials,google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Optional retained integrations. Copy only names proven active by the private
# Vercel/provider name-only inventory. The canonical manifest digest must be
# bound to source-freeze and final evidence; an empty value is disabled. Public callbacks,
# public media, and scheduling remain false even when outbound credentials are
# retained. Never put real values in this example or the inventory manifest.
OPENAI_API_KEY=
RESEND_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
META_APP_ID=
META_APP_SECRET=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
