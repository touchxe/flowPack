{
  "name": "flowpack",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "typecheck": "tsc --noEmit --incremental false",
    "test:nas": "node --test lib/auth-provider-policy.test.mjs lib/nas-media-authorization.test.mjs lib/social-token-continuity.test.mjs scripts/nas-backup-key.test.mjs scripts/nas-compose-boundary.test.mjs scripts/nas-database-artifact.test.mjs scripts/nas-database-operator.test.mjs scripts/nas-dependency-security.test.mjs scripts/nas-live-media-binding.test.mjs scripts/nas-live-cutover-system.test.mjs scripts/nas-live-cutover.test.mjs scripts/nas-media-artifact-handle.test.mjs scripts/nas-media-io.test.mjs scripts/nas-media-migration.test.mjs scripts/nas-media-operator.test.mjs scripts/nas-media-postgres-adapter.test.mjs scripts/nas-media-source-client.test.mjs scripts/nas-media-source-inventory.test.mjs scripts/nas-media-ssh-upload.test.mjs scripts/nas-media-transfer-bundle.test.mjs scripts/nas-migration-ledger.test.mjs scripts/nas-operator.test.mjs scripts/nas-postgres-migration.test.mjs scripts/nas-private-logging-boundary.test.mjs scripts/nas-provider-manifest.test.mjs scripts/nas-release-artifact.test.mjs scripts/nas-remote-database.test.mjs scripts/nas-remote-media-promotion.test.mjs scripts/nas-remote-media-transfer.test.mjs scripts/nas-remote-media-upload.test.mjs scripts/nas-remote-release.test.mjs scripts/nas-restricted-gateway-client.test.mjs scripts/nas/postgres-baseline.test.mjs scripts/nas/storage-boundary.test.mjs scripts/nas/private-integration-boundary.test.mjs lib/nas-storage.test.mjs lib/deployment-boundary.test.mjs",
    "test:nas:db-integration": "node scripts/nas-postgres-migration.integration.mjs",
    "nas:db:rehearse": "node scripts/nas-database-operator.mjs rehearse",
    "nas:db:cutover": "node scripts/nas-database-operator.mjs cutover",
    "nas:db:key:init": "node scripts/nas-backup-key.mjs init --output",
    "test:nas:postgres-baseline": "node --test scripts/nas/postgres-baseline.test.mjs",
    "nas:postgres-baseline:check": "node scripts/nas/postgres-baseline.mjs check",
    "nas:postgres-baseline:prepare": "node scripts/nas/postgres-baseline.mjs prepare",
    "nas:postgres-baseline:authorize": "node scripts/nas/postgres-baseline.mjs authorize",
    "nas:check": "node scripts/nas-operator.mjs check",
    "nas:dry-run": "node scripts/nas-operator.mjs dry-run",
    "nas:deploy": "node scripts/nas-operator.mjs deploy",
    "nas:verify": "node scripts/nas-operator.mjs verify",
    "nas:migration:ledger": "node scripts/nas-migration-ledger.mjs",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c tests/e2e/playwright.config.ts --ui",
    "external-api:key": "node scripts/external-api-key.mjs",
    "external-api:worker": "node scripts/generation-worker-loop.mjs",
    "test:external-api": "node --experimental-strip-types --test lib/external-content-api.test.mjs lib/external-rendered-content.test.mjs scripts/generation-worker-loop.test.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hello-pangea/dnd": "^18.0.1",
